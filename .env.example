# Copy this file to .env on the server and fill in REAL values.
# NEVER commit the real .env.

# PostgreSQL
DB_NAME=nobanno_db
DB_USER=nobanno_user
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=5432

# Set to true to use SQLite instead of PostgreSQL (dev only)
USE_SQLITE=false

# Django
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE
DJANGO_ALLOWED_HOSTS=nobannoapp.online,www.nobannoapp.online,200.234.36.38
# Token lifetime in seconds (default 7 days)
#TOKEN_TTL_SECONDS=604800

# Media/uploaded images directory (outside the synced folder on the server)
#MEDIA_ROOT=/home/s/timage

# Email (Gmail SMTP) — rotate the password!
EMAIL_HOST_USER=nobanno.contact@gmail.com
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=Nobanno <nobanno.contact@gmail.com>

